diff --git a/pkg/apis/batch/validation/validation_test.go b/pkg/apis/batch/validation/validation_test.go
index 02219ab9..2c8a90e2 100644
--- a/pkg/apis/batch/validation/validation_test.go
+++ b/pkg/apis/batch/validation/validation_test.go
@@ -4994,3 +4994,39 @@ func TestValidateScheduleFormatNormalCases(t *testing.T) {
 		})
 	}
 }
+
+func TestValidateCronJobScheduleSpread(t *testing.T) {
+	validPodTemplateSpec := getValidPodTemplateSpecForGenerated(getValidGeneratedSelector())
+	validPodTemplateSpec.Labels = map[string]string{}
+	cases := map[string]struct {
+		spread  *batch.CronJobScheduleSpread
+		wantErr bool
+	}{
+		"unset":             {spread: nil},
+		"one second":        {spread: &batch.CronJobScheduleSpread{MaxDelaySeconds: 1}},
+		"one hour":          {spread: &batch.CronJobScheduleSpread{MaxDelaySeconds: 3600}},
+		"one day":           {spread: &batch.CronJobScheduleSpread{MaxDelaySeconds: MaxCronJobScheduleSpreadSeconds}},
+		"zero":              {spread: &batch.CronJobScheduleSpread{MaxDelaySeconds: 0}, wantErr: true},
+		"negative":          {spread: &batch.CronJobScheduleSpread{MaxDelaySeconds: -5}, wantErr: true},
+		"more than one day": {spread: &batch.CronJobScheduleSpread{MaxDelaySeconds: MaxCronJobScheduleSpreadSeconds + 1}, wantErr: true},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			spec := &batch.CronJobSpec{
+				Schedule:          "0 * * * *",
+				ConcurrencyPolicy: batch.AllowConcurrent,
+				ScheduleSpread:    tc.spread,
+				JobTemplate:       batch.JobTemplateSpec{Spec: batch.JobSpec{Template: validPodTemplateSpec}},
+			}
+			errs := validateCronJobSpec(spec, nil, field.NewPath("spec"), corevalidation.PodValidationOptions{})
+			if got := len(errs) > 0; got != tc.wantErr {
+				t.Fatalf("wantErr=%v, got %v", tc.wantErr, errs)
+			}
+			for _, e := range errs {
+				if e.Field != "spec.scheduleSpread.maxDelaySeconds" {
+					t.Errorf("unexpected field %q", e.Field)
+				}
+			}
+		})
+	}
+}
