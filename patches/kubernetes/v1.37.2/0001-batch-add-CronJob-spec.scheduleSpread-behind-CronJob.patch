+	allErrs = append(allErrs, validateCronJobScheduleSpread(spec.ScheduleSpread, fldPath.Child("scheduleSpread"))...)
 
 	return allErrs
 }
 
+// MaxCronJobScheduleSpreadSeconds is the largest allowed
+// spec.scheduleSpread.maxDelaySeconds: one day.
+const MaxCronJobScheduleSpreadSeconds = 24 * 60 * 60
+
+func validateCronJobScheduleSpread(spread *batch.CronJobScheduleSpread, fldPath *field.Path) field.ErrorList {
+	if spread == nil {
+		return nil
+	}
+	allErrs := field.ErrorList{}
+	if d := spread.MaxDelaySeconds; d < 1 || d > MaxCronJobScheduleSpreadSeconds {
+		allErrs = append(allErrs, field.Invalid(fldPath.Child("maxDelaySeconds"), d, fmt.Sprintf("must be between 1 and %d", MaxCronJobScheduleSpreadSeconds)))
+	}
+	return allErrs
+}
