+func TestCronJobStrategy_DropDisabledScheduleSpread(t *testing.T) {
+	spread := &batch.CronJobScheduleSpread{MaxDelaySeconds: 600}
+	other := &batch.CronJobScheduleSpread{MaxDelaySeconds: 60}
+	cases := map[string]struct {
+		enabled  bool
+		update   bool
+		old, new *batch.CronJobScheduleSpread
+		want     *batch.CronJobScheduleSpread
+	}{
+		"enabled, create":                   {enabled: true, new: spread, want: spread},
+		"disabled, create":                  {enabled: false, new: spread, want: nil},
+		"disabled, update of a user":        {enabled: false, update: true, old: spread, new: other, want: other},
+		"disabled, update adding the field": {enabled: false, update: true, new: spread, want: nil},
+		"enabled, update adding the field":  {enabled: true, update: true, new: spread, want: spread},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			featuregatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.CronJobScheduleSpread, tc.enabled)
+			ctx := genericapirequest.NewDefaultContext()
+			newCJ := &batch.CronJob{
+				ObjectMeta: metav1.ObjectMeta{Name: "spread", Namespace: metav1.NamespaceDefault, ResourceVersion: "1"},
+				Spec:       *validCronjobSpec.DeepCopy(),
+			}
+			newCJ.Spec.ScheduleSpread = tc.new
+			if tc.update {
+				oldCJ := newCJ.DeepCopy()
+				oldCJ.Spec.ScheduleSpread = tc.old
+				Strategy.PrepareForUpdate(ctx, newCJ, oldCJ)
+			} else {
+				Strategy.PrepareForCreate(ctx, newCJ)
+			}
+			if !ptr.Equal(newCJ.Spec.ScheduleSpread, tc.want) {
+				t.Errorf("scheduleSpread = %v, want %v", newCJ.Spec.ScheduleSpread, tc.want)
+			}
+		})
+	}
+}
