+func TestScheduleSpreadOffsetFeatureDisabled(t *testing.T) {
+	featuregatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.CronJobScheduleSpread, false)
+	if got := scheduleSpreadOffset(spreadCronJob("6a2e1f0c", 3600)); got != 0 {
+		t.Errorf("disabled feature must give offset 0, got %v", got)
+	}
+}
+
+func TestSpreadScheduleNext(t *testing.T) {
+	offset := 23*time.Minute + 17*time.Second
+	cases := map[string]struct {
+		schedule string
+		from     string
+		want     string
+	}{
+		"before the delayed time": {schedule: "0 * * * *", from: "2026-11-13T10:00:00Z", want: "2026-11-13T10:23:17Z"},
+		"at the delayed time":     {schedule: "0 * * * *", from: "2026-11-13T10:23:17Z", want: "2026-11-13T11:23:17Z"},
+		"after the delayed time":  {schedule: "0 * * * *", from: "2026-11-13T10:30:00Z", want: "2026-11-13T11:23:17Z"},
+		"daily, across midnight":  {schedule: "50 23 * * *", from: "2026-11-13T23:55:00Z", want: "2026-11-14T00:13:17Z"},
+		// @every is relative to the previous run, so a translation does not move it.
+		"every interval, unaffected": {schedule: "@every 1h", from: "2026-11-13T10:00:00Z", want: "2026-11-13T11:00:00Z"},
+		"time zone":                  {schedule: "TZ=America/New_York 0 3 * * *", from: "2026-11-13T00:00:00Z", want: "2026-11-13T08:23:17Z"},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			sched, err := cron.ParseStandard(tc.schedule)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := spreadSchedule{schedule: sched, offset: offset}.Next(mustParseTime(t, tc.from))
+			if want := mustParseTime(t, tc.want); !got.Equal(want) {
+				t.Errorf("Next(%s) = %s, want %s", tc.from, got.UTC().Format(time.RFC3339), tc.want)
+			}
+		})
+	}
+
+	never, err := cron.ParseStandard("0 0 30 2 *")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := (spreadSchedule{schedule: never, offset: offset}).Next(mustParseTime(t, "2026-11-13T00:00:00Z")); !got.IsZero() {
+		t.Errorf("a schedule that never fires must stay zero, got %s", got)
+	}
+}
+
+// The translated schedule keeps the controller's missed-schedule and deadline
+// accounting: it is measured from the delayed times.
+func TestMostRecentScheduleTimeWithSpread(t *testing.T) {
+	inner, err := cron.ParseStandard("0 * * * *")
+	if err != nil {
+		t.Fatal(err)
+	}
+	offset := 23*time.Minute + 17*time.Second
+	sched := spreadSchedule{schedule: inner, offset: offset}
+
+	cj := cronJob()
+	cj.CreationTimestamp = metav1.Time{Time: mustParseTime(t, "2026-11-13T09:50:00Z")}
+	cj.Status.LastScheduleTime = &metav1.Time{Time: mustParseTime(t, "2026-11-13T10:23:17Z")}
+
+	_, recent, missed, err := mostRecentScheduleTime(&cj, mustParseTime(t, "2026-11-13T12:30:00Z"), sched, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if recent == nil || !recent.Equal(mustParseTime(t, "2026-11-13T12:23:17Z")) || missed != fewMissed {
+		t.Errorf("got recent=%v missed=%v, want 12:23:17 and few missed", recent, missed)
+	}
+
+	cj.Spec.StartingDeadlineSeconds = ptr.To[int64](60)
+	logger, _ := ktesting.NewTestContext(t)
+	recorder := record.NewFakeRecorder(10)
+	// Within the deadline of the delayed 11:23:17 run.
+	got, err := nextScheduleTime(logger, &cj, mustParseTime(t, "2026-11-13T11:23:50Z"), sched, recorder)
+	if err != nil || got == nil || !got.Equal(mustParseTime(t, "2026-11-13T11:23:17Z")) {
+		t.Errorf("within deadline: got %v, %v; want 11:23:17", got, err)
+	}
+	// Past the deadline of the delayed run: nothing to start.
+	got, err = nextScheduleTime(logger, &cj, mustParseTime(t, "2026-11-13T11:25:00Z"), sched, recorder)
+	if err != nil || got != nil {
+		t.Errorf("past deadline: got %v, %v; want nil", got, err)
+	}
+}
+
+func TestControllerV2SyncCronJobScheduleSpread(t *testing.T) {
+	const uid = "6a2e1f0c-5d4b-4c1a-9e8f-0b7a6c5d4e3f"
+	nominal := mustParseTime(t, "2026-11-13T10:00:00Z")
+
+	featuregatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.CronJobScheduleSpread, true)
+	offset := scheduleSpreadOffset(spreadCronJob(uid, 3600))
+	if offset < 2*time.Second {
+		t.Fatalf("test setup: offset %v too small for this test", offset)
+	}
+
+	cases := map[string]struct {
+		enabled     bool
+		now         time.Time
+		wantJobAt   *time.Time
+		wantRequeue time.Duration
+	}{
+		"enabled, nominal time passed, delayed time not yet": {
+			enabled:     true,
+			now:         nominal.Add(offset - time.Second),
+			wantRequeue: time.Second + nextScheduleDelta,
+		},
+		"enabled, delayed time reached": {
+			enabled:     true,
+			now:         nominal.Add(offset + time.Second),
+			wantJobAt:   ptr.To(nominal.Add(offset)),
+			wantRequeue: time.Hour - time.Second + nextScheduleDelta,
+		},
+		"disabled, the field is ignored": {
+			enabled:     false,
+			now:         nominal.Add(offset + time.Second),
+			wantJobAt:   ptr.To(nominal),
+			wantRequeue: time.Hour - offset - time.Second + nextScheduleDelta,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			featuregatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.CronJobScheduleSpread, tc.enabled)
+			cj := spreadCronJob(uid, 3600)
+			cj.CreationTimestamp = metav1.Time{Time: nominal.Add(-time.Second)}
+
+			jc := &fakeJobControl{}
+			cjc := &fakeCJControl{CronJob: cj.DeepCopy()}
+			jm := ControllerV2{
+				jobControl:     jc,
+				cronJobControl: cjc,
+				recorder:       record.NewFakeRecorder(10),
+				now:            func() time.Time { return tc.now },
+			}
+			requeue, _, err := jm.syncCronJob(context.TODO(), cj, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if requeue == nil || *requeue != tc.wantRequeue {
+				t.Errorf("requeue after %v, want %v", requeue, tc.wantRequeue)
+			}
+			if tc.wantJobAt == nil {
+				if len(jc.Jobs) != 0 {
+					t.Fatalf("expected no job, got %d", len(jc.Jobs))
+				}
+				return
+			}
+			if len(jc.Jobs) != 1 {
+				t.Fatalf("expected one job, got %d", len(jc.Jobs))
+			}
+			job := jc.Jobs[0]
+			if want := getJobName(cj, *tc.wantJobAt); job.Name != want {
+				t.Errorf("job name %q, want %q", job.Name, want)
+			}
+			if got, want := job.Annotations[batchv1.CronJobScheduledTimestampAnnotation], tc.wantJobAt.Format(time.RFC3339); got != want {
+				t.Errorf("scheduled-timestamp annotation %q, want %q", got, want)
+			}
+			if cj.Status.LastScheduleTime == nil || !cj.Status.LastScheduleTime.Time.Equal(*tc.wantJobAt) {
+				t.Errorf("lastScheduleTime %v, want %v", cj.Status.LastScheduleTime, *tc.wantJobAt)
+			}
+		})
+	}
+}
