+func mustParseTime(t *testing.T, s string) time.Time {
+	t.Helper()
+	v, err := time.Parse(time.RFC3339, s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+
+func spreadCronJob(uid string, maxDelaySeconds int32) *batchv1.CronJob {
+	cj := cronJob()
+	cj.UID = types.UID(uid)
+	cj.Spec.Schedule = onTheHour
+	cj.Spec.ScheduleSpread = &batchv1.CronJobScheduleSpread{MaxDelaySeconds: maxDelaySeconds}
+	return &cj
+}
+
+func TestScheduleSpreadOffset(t *testing.T) {
+	featuregatetesting.SetFeatureGateDuringTest(t, utilfeature.DefaultFeatureGate, features.CronJobScheduleSpread, true)
+
+	cj := spreadCronJob("6a2e1f0c-5d4b-4c1a-9e8f-0b7a6c5d4e3f", 3600)
+	first := scheduleSpreadOffset(cj)
+	for i := 0; i < 3; i++ {
+		if got := scheduleSpreadOffset(cj.DeepCopy()); got != first {
+			t.Fatalf("offset is not stable: %v then %v", first, got)
+		}
+	}
+	// Name, namespace, schedule and other spec fields do not move the offset.
+	renamed := cj.DeepCopy()
+	renamed.Name, renamed.Namespace, renamed.Spec.Schedule = "other", "elsewhere", "*/5 * * * *"
+	if got := scheduleSpreadOffset(renamed); got != first {
+		t.Errorf("offset depends on more than the UID: %v vs %v", got, first)
+	}
+
+	if got := scheduleSpreadOffset(spreadCronJob("x", 1)); got != 0 {
+		t.Errorf("maxDelaySeconds=1 must give offset 0, got %v", got)
+	}
+	unset := cronJob()
+	if got := scheduleSpreadOffset(&unset); got != 0 {
+		t.Errorf("no spread must give offset 0, got %v", got)
+	}
+
+	// 2000 CronJobs at the same schedule: offsets stay in range, are whole
+	// seconds and cover the interval instead of clustering.
+	const n, maxDelay = 2000, 3600
+	perMinute := map[int64]int{}
+	for i := 0; i < n; i++ {
+		off := scheduleSpreadOffset(spreadCronJob(fmt.Sprintf("00000000-0000-0000-0000-%012d", i), maxDelay))
+		if off < 0 || off >= maxDelay*time.Second || off%time.Second != 0 {
+			t.Fatalf("offset %v out of [0, %ds) or not whole seconds", off, maxDelay)
+		}
+		perMinute[int64(off/time.Minute)]++
+	}
+	if len(perMinute) != 60 {
+		t.Errorf("expected all 60 minutes used, got %d", len(perMinute))
+	}
+	for m, c := range perMinute {
+		// Mean is 33.3 per minute; a uniform hash stays far below 3x that.
+		if c > 100 {
+			t.Errorf("minute %d holds %d of %d CronJobs", m, c, n)
+		}
+	}
+}
