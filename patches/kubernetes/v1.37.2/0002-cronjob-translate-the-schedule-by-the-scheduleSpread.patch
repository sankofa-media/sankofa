+// scheduleSpreadOffset returns the stable delay added to every scheduled time
+// of cj: FNV-1a (64 bit) of the CronJob's UID modulo
+// spec.scheduleSpread.maxDelaySeconds, in whole seconds. It is zero when the
+// feature is disabled or the CronJob does not ask for a spread.
+func scheduleSpreadOffset(cj *batchv1.CronJob) time.Duration {
+	if !utilfeature.DefaultFeatureGate.Enabled(features.CronJobScheduleSpread) {
+		return 0
+	}
+	spread := cj.Spec.ScheduleSpread
+	if spread == nil || spread.MaxDelaySeconds < 1 {
+		return 0
+	}
+	h := fnv.New64a()
+	_, _ = h.Write([]byte(cj.UID))
+	return time.Duration(h.Sum64()%uint64(spread.MaxDelaySeconds)) * time.Second
+}
+
+// spreadSchedule is a cron schedule translated in time by a constant offset:
+// every activation of the underlying schedule happens offset later. A
+// translation keeps the order of activations and the intervals between them,
+// so missed-schedule accounting, startingDeadlineSeconds and concurrencyPolicy
+// work on the translated times unchanged.
+type spreadSchedule struct {
+	schedule cron.Schedule
+	offset   time.Duration
+}
+
+// Next returns the first translated activation strictly after t.
+func (s spreadSchedule) Next(t time.Time) time.Time {
+	next := s.schedule.Next(t.Add(-s.offset))
+	if next.IsZero() {
+		// The underlying schedule never fires (for example "0 0 30 2 *").
+		return next
+	}
+	return next.Add(s.offset)
+}
+
+// withScheduleSpread returns sched translated by the CronJob's spread offset,
+// or sched itself when there is no offset.
+func withScheduleSpread(cj *batchv1.CronJob, sched cron.Schedule) cron.Schedule {
+	if offset := scheduleSpreadOffset(cj); offset > 0 {
+		return spreadSchedule{schedule: sched, offset: offset}
+	}
+	return sched
+}
